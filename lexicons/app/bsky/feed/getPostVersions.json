{
  "lexicon": 1,
  "id": "app.bsky.feed.getPostVersions",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the version history of a post. Only versions the AppView accepted as valid edits are included.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri",
            "description": "Reference (AT-URI) of post record"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "versions"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" },
            "versions": {
              "type": "array",
              "description": "Versions of the post, oldest first. Includes the current version, so an unedited post has a single entry.",
              "items": { "type": "ref", "ref": "#postVersion" }
            }
          }
        }
      },
      "errors": [{ "name": "NotFound" }]
    },
    "postVersion": {
      "type": "object",
      "required": ["cid", "record", "indexedAt"],
      "properties": {
        "cid": { "type": "string", "format": "cid" },
        "record": { "type": "unknown" },
        "indexedAt": {
          "type": "string",
          "format": "datetime",
          "description": "Timestamp when this version of the post was indexed."
        }
      }
    }
  }
}
