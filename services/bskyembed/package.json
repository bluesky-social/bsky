{
  "name": "@bsky/embed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev-snippet": "tsc --project tsconfig.snippet.json && serve -s dist -p 3000 -n",
    "build": "tsc && vite build && pnpm build-snippet",
    "build-snippet": "tsc --project tsconfig.snippet.json",
    "analyze": "ANALYZE=1 vite build",
    "lint": "eslint --cache src snippet vite.config.ts eslint.config.mjs tailwind.config.mjs postcss.config.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier -w src"
  },
  "dependencies": {
    "@atproto/lex": "^0.3.13",
    "@atproto/syntax": "^0.7.6",
    "@bsky/sdk": "workspace:*",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-bundle-analyzer": "^1.3.9"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
