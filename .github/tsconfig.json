{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "../tsconfig/base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false,
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // scripts run directly via node type stripping
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
  },
  "include": ["scripts/**/*.ts"],
}
