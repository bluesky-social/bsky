{
  "id": "app.bsky.feed.hydrateFeedSkeleton",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "schema": {
          "type": "object",
          "required": ["feed"],
          "properties": {
            "feed": {
              "type": "array",
              "items": {
                "ref": "app.bsky.feed.defs#skeletonFeedPost",
                "type": "ref"
              },
              "maxLength": 100
            },
            "reqId": {
              "type": "string",
              "maxLength": 100,
              "description": "Unique identifier per request that may be passed back alongside interactions. Set on each item of the output feed."
            }
          }
        },
        "encoding": "application/json"
      },
      "output": {
        "schema": {
          "type": "object",
          "required": ["feed"],
          "properties": {
            "feed": {
              "type": "array",
              "items": {
                "ref": "app.bsky.feed.defs#feedViewPost",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "description": "Hydrate a feed skeleton, as returned by app.bsky.feed.getFeedSkeleton, into a feed, as returned by app.bsky.feed.getFeed."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
