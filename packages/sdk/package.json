{
  "name": "@bsky.app/sdk",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Client library for Bluesky",
  "keywords": [
    "atproto",
    "bluesky",
    "api",
    "sdk"
  ],
  "homepage": "https://bsky.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/bsky",
    "directory": "packages/sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lexicons": {
      "types": "./dist/lexicons-export.d.ts",
      "default": "./dist/lexicons-export.js"
    },
    "./moderation": {
      "types": "./dist/moderation/index.d.ts",
      "default": "./dist/moderation/index.js"
    },
    "./richtext": {
      "types": "./dist/rich-text/index.d.ts",
      "default": "./dist/rich-text/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist",
    "lexicons",
    "lexicons.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@atproto/common-web": "^0.5.3",
    "@atproto/lex-client": "^0.2.1",
    "@atproto/lex-schema": "^0.1.6",
    "@atproto/lexicon": "^0.7.4",
    "@atproto/syntax": "^0.6.4",
    "@atproto/xrpc": "^0.8.3",
    "await-lock": "^3.0.0",
    "multiformats": "^13.0.0",
    "tlds": "^1.234.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@atproto/lex": "^0.1.7",
    "prettier": "^3.9.4",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "codegen": "lex build --clear --index-file --out ./src/lexicons",
    "prebuild": "pnpm run codegen",
    "build": "tsgo --build tsconfig.build.json",
    "test": "vitest run"
  }
}
