{
  "name": "@bsky/sdk",
  "version": "1.1.2",
  "license": "MIT OR Apache-2.0",
  "description": "Bluesky SDK for use with @atproto/lex",
  "keywords": [
    "bluesky",
    "atproto",
    "sdk",
    "lexicon"
  ],
  "homepage": "https://bsky.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluesky-social/bsky",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lexicons": {
      "types": "./dist/lexicons-export.d.ts",
      "default": "./dist/lexicons-export.js"
    },
    "./moderation": {
      "types": "./dist/moderation/index.d.ts",
      "default": "./dist/moderation/index.js"
    },
    "./richtext": {
      "types": "./dist/rich-text/index.d.ts",
      "default": "./dist/rich-text/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist",
    "lexicons",
    "lexicons.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@atproto-labs/handle-resolver": "^0.4.6",
    "@atproto/syntax": "^0.7.2",
    "tlds": "^1.261.0"
  },
  "peerDependencies": {
    "@atproto/lex": "^0.3.0"
  },
  "devDependencies": {
    "@atproto/lex": "^0.3.0",
    "@atproto/lex-password-session": "^0.1.8",
    "prettier": "^3.9.5",
    "rolldown": "1.1.4",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "codegen": "lex build --clear --index-file --out ./src/lexicons --exclude 'app.bsky.unspecced.*' 'tools.ozone.*' 'chat.bsky.convo.exportAccountData'",
    "codegen:labels": "node ./scripts/generate-code.mjs",
    "prebuild": "pnpm run codegen && pnpm run codegen:labels",
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run",
    "test:peer-matrix": "node ./scripts/peer-matrix.mjs",
    "measure:bundle": "node ./scripts/measure-bundle.mjs"
  }
}
